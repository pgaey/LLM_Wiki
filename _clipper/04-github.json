{
	"schemaVersion": "0.1.0",
	"name": "04 GitHub (issue/PR/README/discussion)",
	"behavior": "create",
	"noteContentFormat": "# {{title}}\n\n🐙 **GitHub**: {{url}}\n📁 **리포**: `{{domain}}{{path}}`\n\n---\n\n{{content}}",
	"properties": [
		{
			"name": "source_type",
			"value": "article",
			"type": "text"
		},
		{
			"name": "doc_type",
			"value": "github",
			"type": "text"
		},
		{
			"name": "source_url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\", \"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "captured",
			"value": "{{date|date:\"YYYY-MM-DD\"}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings, github, code",
			"type": "multitext"
		},
		{
			"name": "reason",
			"value": "",
			"type": "text"
		},
		{
			"name": "ingest_mode",
			"value": "learn",
			"type": "text"
		},
		{
			"name": "status",
			"value": "raw",
			"type": "text"
		}
	],
	"triggers": [
		"https://github.com/"
	],
	"noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}}-gh-{{title|slugify}}",
	"path": "raw/articles"
}
