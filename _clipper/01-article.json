{
	"schemaVersion": "0.1.0",
	"name": "01 아티클 (기본)",
	"behavior": "create",
	"noteContentFormat": "# {{title}}\n\n> {{description}}\n\n{{content}}",
	"properties": [
		{
			"name": "source_type",
			"value": "article",
			"type": "text"
		},
		{
			"name": "source_url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\", \"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{published}}",
			"type": "date"
		},
		{
			"name": "captured",
			"value": "{{date|date:\"YYYY-MM-DD\"}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings, article",
			"type": "multitext"
		},
		{
			"name": "reason",
			"value": "",
			"type": "text"
		},
		{
			"name": "ingest_mode",
			"value": "learn",
			"type": "text"
		},
		{
			"name": "status",
			"value": "raw",
			"type": "text"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}}-{{title|slugify}}",
	"path": "raw/articles"
}
